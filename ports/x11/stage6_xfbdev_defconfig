# H3531 Stage6.0 - Xfbdev hardware proof
# Target: HiSilicon Hi3531 / Cortex-A9 / ARMv7-A / EABI soft-float / NO NEON

BR2_arm=y
BR2_cortex_a9=y
# BR2_ARM_ENABLE_NEON is not set
# BR2_ARM_ENABLE_VFP is not set
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y

BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_PTHREADS_NATIVE=y
BR2_USE_WCHAR=y

# Build shared userspace so the matching uClibc loader and libraries can be
# bundled next to Xfbdev on USB and invoked explicitly on the vendor rootfs.
BR2_SHARED_LIBS=y
BR2_OPTIMIZE_2=y

BR2_TARGET_GENERIC_HOSTNAME="h3531-x11-proof"
BR2_TARGET_GENERIC_ISSUE="H3531 Stage6.0 Xfbdev proof"
BR2_ROOTFS_DEVICE_CREATION_STATIC=y

BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_V_1_14=y
BR2_PACKAGE_XSERVER_XORG_SERVER_KDRIVE=y
BR2_PACKAGE_XSERVER_XORG_SERVER_KDRIVE_EVDEV=y
# BR2_PACKAGE_XSERVER_XORG_SERVER_KDRIVE_KBD is not set
# BR2_PACKAGE_XSERVER_XORG_SERVER_KDRIVE_MOUSE is not set
# BR2_PACKAGE_XSERVER_XORG_SERVER_XVFB is not set
# BR2_PACKAGE_XSERVER_XORG_SERVER_AIGLX is not set

BR2_PACKAGE_XAPP_XEV=y
BR2_PACKAGE_XAPP_XSETROOT=y
BR2_PACKAGE_XAPP_XDPYINFO=y

BR2_TARGET_ROOTFS_TAR=y
