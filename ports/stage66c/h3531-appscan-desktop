#!/bin/sh
# H3531 D6.3 transactional application registry.
# Minimal-BusyBox compatible: no expr, no shell arithmetic, no let, no cmp.
# Existing desktop shortcuts are not removed until a complete new registry
# has been generated successfully.

APPS="${H3531_APPS_ROOT:-/mnt/usb/H3531/APPS}"
BASE="$APPS/x11-debian"
HOME_DIR="${H3531_HOME_DIR:-/var/h3531-lxde}"
VENDOR_DATA="${H3531_VENDOR_DATA:-/var/h3531-vendor/share}"
DESKTOP="$HOME_DIR/Desktop"

STAGE="${H3531_APPSCAN_STAGE:-/var/h3531-appscan-stage}"
STAGE_APPS="$STAGE/applications"
STAGE_DESKTOP="$STAGE/Desktop"
DEFAULT_RAW="$STAGE/defaults.raw"
ADDED_RAW="$STAGE/added.raw"

rm -rf "$STAGE" 2>/dev/null
mkdir -p "$STAGE_APPS" "$STAGE_DESKTOP" "$VENDOR_DATA/applications" "$DESKTOP" 2>/dev/null || {
    echo "H3531 appscan ERROR: cannot create staging directories" >&2
    exit 2
}

: >"$DEFAULT_RAW" || exit 3
: >"$ADDED_RAW" || exit 3

write_entry()
{
    OUT="$1"
    APP_ID="$2"
    APP_NAME="$3"
    APP_COMMENT="$4"
    APP_MODE="$5"
    APP_CATEGORIES="$6"
    APP_ICON="$7"
    APP_MIME="$8"

    {
        echo "[Desktop Entry]"
        echo "Type=Application"
        echo "Name=$APP_NAME"
        [ -n "$APP_COMMENT" ] && echo "Comment=$APP_COMMENT"
        echo "Exec=/mnt/usb/H3531/APPS/h3531-app-run $APP_ID $APP_MODE %f"
        echo "TryExec=/mnt/usb/H3531/APPS/h3531-app-run"
        echo "Terminal=false"
        echo "Categories=$APP_CATEGORIES"
        echo "Icon=$APP_ICON"
        [ -n "$APP_MIME" ] && echo "MimeType=$APP_MIME;"
        echo "StartupNotify=false"
    } >"$OUT" || return 1

    chmod 755 "$OUT" 2>/dev/null || true
    return 0
}

for CFG in "$APPS"/*/APPINFO.CFG; do
    [ -f "$CFG" ] || continue

    FORMAT=
    ID=
    NAME=
    COMMENT=
    BACKEND=
    EXEC_WINDOW=
    EXEC_FULLSCREEN=
    EXEC_NATIVE=
    MIME=
    DEFAULT_MIME=1
    CATEGORIES=
    ICON=
    DESKTOP_ICON=0

    while IFS='=' read -r key value; do
        case "$key" in
            FORMAT) FORMAT="$value" ;;
            ID) ID="$value" ;;
            NAME) NAME="$value" ;;
            COMMENT) COMMENT="$value" ;;
            BACKEND) BACKEND="$value" ;;
            EXEC_WINDOW) EXEC_WINDOW="$value" ;;
            EXEC_FULLSCREEN) EXEC_FULLSCREEN="$value" ;;
            EXEC_NATIVE) EXEC_NATIVE="$value" ;;
            MIME) MIME="$value" ;;
            DEFAULT_MIME) DEFAULT_MIME="$value" ;;
            CATEGORIES) CATEGORIES="$value" ;;
            ICON) ICON="$value" ;;
            DESKTOP_ICON) DESKTOP_ICON="$value" ;;
        esac
    done <"$CFG"

    case "$FORMAT" in 1|2) ;; *) continue ;; esac
    [ -n "$ID" ] || continue
    [ -n "$NAME" ] || continue
    case "$ID" in *[!A-Za-z0-9_-]*) continue ;; esac
    case "$DEFAULT_MIME" in 0|1) ;; *) DEFAULT_MIME=1 ;; esac

    case "$BACKEND" in
        x11) [ -x "$EXEC_WINDOW" ] || continue ;;
        native-fb) [ -x "$EXEC_NATIVE" ] || continue ;;
        *) continue ;;
    esac

    [ -n "$CATEGORIES" ] || CATEGORIES="Utility;"
    [ -n "$ICON" ] || ICON="application-x-executable"

    ENTRY="$STAGE_APPS/h3531-$ID.desktop"
    write_entry "$ENTRY" "$ID" "$NAME" "$COMMENT" "window" "$CATEGORIES" "$ICON" "$MIME" || {
        echo "H3531 appscan ERROR: cannot create $ID desktop entry" >&2
        rm -rf "$STAGE" 2>/dev/null
        exit 4
    }

    if [ "$DESKTOP_ICON" = "1" ]; then
        cp "$ENTRY" "$STAGE_DESKTOP/H3531-$ID.desktop" || {
            echo "H3531 appscan ERROR: cannot stage desktop shortcut for $ID" >&2
            rm -rf "$STAGE" 2>/dev/null
            exit 5
        }
        chmod 755 "$STAGE_DESKTOP/H3531-$ID.desktop" 2>/dev/null || true
    fi

    if [ "$BACKEND" = "x11" ] && [ -n "$EXEC_FULLSCREEN" ] && [ -x "$EXEC_FULLSCREEN" ]; then
        FSENTRY="$STAGE_APPS/h3531-$ID-fullscreen.desktop"
        write_entry "$FSENTRY" "$ID" "$NAME (Fullscreen)" "$COMMENT" "fullscreen" "$CATEGORIES" "$ICON" "$MIME" || {
            echo "H3531 appscan ERROR: cannot create fullscreen entry for $ID" >&2
            rm -rf "$STAGE" 2>/dev/null
            exit 6
        }
    fi

    if [ -n "$MIME" ]; then
        OLDIFS="$IFS"
        IFS=';'
        for MT in $MIME; do
            [ -n "$MT" ] || continue
            echo "$MT|h3531-$ID.desktop" >>"$ADDED_RAW"
            [ "$DEFAULT_MIME" = "1" ] && echo "$MT|h3531-$ID.desktop" >>"$DEFAULT_RAW"
        done
        IFS="$OLDIFS"
    fi
done

write_defaults()
{
    SEEN='|'
    while IFS='|' read -r MT APP; do
        [ -n "$MT" ] || continue
        case "$SEEN" in *"|$MT|"*) continue ;; esac
        SEEN="$SEEN$MT|"

        LAST=
        while IFS='|' read -r MT2 APP2; do
            [ "$MT2" = "$MT" ] && LAST="$APP2"
        done <"$DEFAULT_RAW"

        [ -n "$LAST" ] && echo "$MT=$LAST;"
    done <"$DEFAULT_RAW"
}

write_added()
{
    SEEN='|'
    while IFS='|' read -r MT APP; do
        [ -n "$MT" ] || continue
        case "$SEEN" in *"|$MT|"*) continue ;; esac
        SEEN="$SEEN$MT|"

        LIST=
        while IFS='|' read -r MT2 APP2; do
            [ "$MT2" = "$MT" ] || continue
            case ";$LIST" in
                *";$APP2;"*) ;;
                *) LIST="$LIST$APP2;" ;;
            esac
        done <"$ADDED_RAW"

        [ -n "$LIST" ] && echo "$MT=$LIST"
    done <"$ADDED_RAW"
}

{
    echo "# H3531 vendor MIME defaults - generated by appscan"
    echo "[Default Applications]"
    write_defaults
    echo
    echo "[Added Associations]"
    write_added
} >"$STAGE_APPS/mimeapps.list" || exit 7

{
    echo "[Default Applications]"
    write_defaults
} >"$STAGE_APPS/defaults.list" || exit 7

{
    echo "[MIME Cache]"
    write_added
} >"$STAGE_APPS/mimeinfo.cache" || exit 7

# Staging is complete. Only now replace the writable vendor registry.
# Built-in application entries remain read-only under $BASE/share/applications.
rm -f "$VENDOR_DATA/applications"/h3531-*.desktop 2>/dev/null

for NEW in "$STAGE_APPS"/h3531-*.desktop; do
    [ -f "$NEW" ] || continue
    cp "$NEW" "$SYSTEM_APPS/" || {
        echo "H3531 appscan ERROR: cannot install application entry $NEW" >&2
        exit 8
    }
done

cp "$STAGE_APPS/mimeapps.list" "$SYSTEM_APPS/mimeapps.list" || exit 9
cp "$STAGE_APPS/defaults.list" "$SYSTEM_APPS/defaults.list" || exit 9
cp "$STAGE_APPS/mimeinfo.cache" "$SYSTEM_APPS/mimeinfo.cache" || exit 9

# Desktop shortcuts are replaced only after successful staging.
rm -f "$DESKTOP"/H3531-*.desktop 2>/dev/null
for NEW in "$STAGE_DESKTOP"/H3531-*.desktop; do
    [ -f "$NEW" ] || continue
    cp "$NEW" "$DESKTOP/" || {
        echo "H3531 appscan ERROR: cannot install desktop shortcut $NEW" >&2
        exit 10
    }
done

rm -rf "$STAGE" 2>/dev/null

echo "H3531 appscan: registry refreshed successfully"
exit 0
