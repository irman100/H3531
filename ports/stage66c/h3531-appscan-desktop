#!/bin/sh
# H3531 D6 application registry.
# Freedesktop-compatible .desktop + mimeapps handling.
# User defaults are persistent on USB and are NEVER overwritten by appscan.

APPS=/mnt/usb/H3531/APPS
BASE="$APPS/x11-debian"
HOME_DIR=/var/h3531-lxde
PERSIST_ROOT=/mnt/usb/H3531/USER
USER_CONFIG="$PERSIST_ROOT/config"
USER_DATA="$PERSIST_ROOT/share"
USER_APPS="$USER_DATA/applications"
SYSTEM_APPS="$BASE/share/applications"
DESKTOP="$HOME_DIR/Desktop"
DEFAULT_RAW=/var/h3531-appscan-defaults.raw
ADDED_RAW=/var/h3531-appscan-added.raw

mkdir -p "$USER_CONFIG" "$USER_APPS" "$SYSTEM_APPS" "$DESKTOP" 2>/dev/null || exit 2
rm -f "$USER_APPS"/h3531-*.desktop 2>/dev/null
rm -f "$DESKTOP"/H3531-*.desktop 2>/dev/null
: >"$DEFAULT_RAW"
: >"$ADDED_RAW"
COUNT=0

for CFG in "$APPS"/*/APPINFO.CFG; do
    [ -f "$CFG" ] || continue
    FORMAT=
    ID=
    NAME=
    COMMENT=
    BACKEND=
    EXEC_WINDOW=
    EXEC_FULLSCREEN=
    EXEC_NATIVE=
    MIME=
    DEFAULT_MIME=1
    CATEGORIES=
    ICON=
    DESKTOP_ICON=0

    while IFS='=' read -r key value; do
        case "$key" in
            FORMAT) FORMAT="$value" ;;
            ID) ID="$value" ;;
            NAME) NAME="$value" ;;
            COMMENT) COMMENT="$value" ;;
            BACKEND) BACKEND="$value" ;;
            EXEC_WINDOW) EXEC_WINDOW="$value" ;;
            EXEC_FULLSCREEN) EXEC_FULLSCREEN="$value" ;;
            EXEC_NATIVE) EXEC_NATIVE="$value" ;;
            MIME) MIME="$value" ;;
            DEFAULT_MIME) DEFAULT_MIME="$value" ;;
            CATEGORIES) CATEGORIES="$value" ;;
            ICON) ICON="$value" ;;
            DESKTOP_ICON) DESKTOP_ICON="$value" ;;
        esac
    done <"$CFG"

    case "$FORMAT" in 1|2) ;; *) continue ;; esac
    [ -n "$ID" ] || continue
    [ -n "$NAME" ] || continue
    case "$ID" in *[!A-Za-z0-9_-]*) continue ;; esac
    case "$DEFAULT_MIME" in 0|1) ;; *) DEFAULT_MIME=1 ;; esac

    case "$BACKEND" in
        x11) [ -x "$EXEC_WINDOW" ] || continue ;;
        native-fb) [ -x "$EXEC_NATIVE" ] || continue ;;
        *) continue ;;
    esac

    [ -n "$CATEGORIES" ] || CATEGORIES="Utility;"
    [ -n "$ICON" ] || ICON="application-x-executable"
    ENTRY="$USER_APPS/h3531-$ID.desktop"

    {
        echo "[Desktop Entry]"
        echo "Type=Application"
        echo "Name=$NAME"
        [ -n "$COMMENT" ] && echo "Comment=$COMMENT"
        echo "Exec=/mnt/usb/H3531/APPS/h3531-app-run $ID window %f"
        echo "TryExec=/mnt/usb/H3531/APPS/h3531-app-run"
        echo "Terminal=false"
        echo "Categories=$CATEGORIES"
        echo "Icon=$ICON"
        [ -n "$MIME" ] && echo "MimeType=$MIME;"
        echo "StartupNotify=false"
    } >"$ENTRY"
    chmod 755 "$ENTRY" 2>/dev/null || true

    if [ "$DESKTOP_ICON" = "1" ]; then
        cp "$ENTRY" "$DESKTOP/H3531-$ID.desktop" 2>/dev/null || true
        chmod 755 "$DESKTOP/H3531-$ID.desktop" 2>/dev/null || true
    fi

    if [ "$BACKEND" = "x11" ] && [ -n "$EXEC_FULLSCREEN" ] && [ -x "$EXEC_FULLSCREEN" ]; then
        FSENTRY="$USER_APPS/h3531-$ID-fullscreen.desktop"
        {
            echo "[Desktop Entry]"
            echo "Type=Application"
            echo "Name=$NAME (Fullscreen)"
            [ -n "$COMMENT" ] && echo "Comment=$COMMENT"
            echo "Exec=/mnt/usb/H3531/APPS/h3531-app-run $ID fullscreen %f"
            echo "TryExec=/mnt/usb/H3531/APPS/h3531-app-run"
            echo "Terminal=false"
            echo "Categories=$CATEGORIES"
            echo "Icon=$ICON"
            [ -n "$MIME" ] && echo "MimeType=$MIME;"
            echo "StartupNotify=false"
        } >"$FSENTRY"
        chmod 755 "$FSENTRY" 2>/dev/null || true
    fi

    if [ -n "$MIME" ]; then
        OLDIFS="$IFS"
        IFS=';'
        for MT in $MIME; do
            [ -n "$MT" ] || continue
            echo "$MT|h3531-$ID.desktop" >>"$ADDED_RAW"
            if [ "$DEFAULT_MIME" = "1" ]; then
                echo "$MT|h3531-$ID.desktop" >>"$DEFAULT_RAW"
            fi
        done
        IFS="$OLDIFS"
    fi

    COUNT=`expr "$COUNT" + 1`
done

write_defaults()
{
    SEEN='|'
    while IFS='|' read -r MT APP; do
        [ -n "$MT" ] || continue
        case "$SEEN" in *"|$MT|"*) continue ;; esac
        SEEN="$SEEN$MT|"
        LAST=
        while IFS='|' read -r MT2 APP2; do
            [ "$MT2" = "$MT" ] && LAST="$APP2"
        done <"$DEFAULT_RAW"
        [ -n "$LAST" ] && echo "$MT=$LAST;"
    done <"$DEFAULT_RAW"
}

write_added()
{
    SEEN='|'
    while IFS='|' read -r MT APP; do
        [ -n "$MT" ] || continue
        case "$SEEN" in *"|$MT|"*) continue ;; esac
        SEEN="$SEEN$MT|"
        LIST=
        while IFS='|' read -r MT2 APP2; do
            [ "$MT2" = "$MT" ] || continue
            case ";$LIST" in
                *";$APP2;"*) ;;
                *) LIST="$LIST$APP2;" ;;
            esac
        done <"$ADDED_RAW"
        [ -n "$LIST" ] && echo "$MT=$LIST"
    done <"$ADDED_RAW"
}

# Vendor/system defaults are regenerated from APPINFO manifests.
# They are lower priority than the user's own persistent mimeapps.list.
{
    echo "# H3531 vendor MIME defaults - generated by appscan"
    echo "[Default Applications]"
    write_defaults
    echo
    echo "[Added Associations]"
    write_added
} >"$SYSTEM_APPS/mimeapps.list"

{
    echo "[Default Applications]"
    write_defaults
} >"$SYSTEM_APPS/defaults.list"

# Standard desktop MIME cache used by GIO/libfm to populate Open With.
{
    echo "[MIME Cache]"
    write_added
} >"$USER_APPS/mimeinfo.cache"

# Do NOT write USER_CONFIG/mimeapps.list or USER_APPS/mimeapps.list here.
# PCManFM/GIO owns those files. The Open With "always use" checkbox writes
# the user's selection there, and because the XDG dirs live on USB it persists.

echo "H3531 appscan: registered $COUNT application(s)"
echo "H3531 appscan: user MIME preferences are persistent under $PERSIST_ROOT"
exit 0
