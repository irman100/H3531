#!/bin/sh
# H3531 Stage6.6C Native App Bridge.
# Pauses the persistent X server without destroying LXDE, runs one native
# framebuffer application, restores framebuffer/HIFB state, then resumes X.

BASE=/mnt/usb/H3531/APPS/x11-debian
LOADER="$BASE/lib/ld-linux.so.3"
LIBPATH="$BASE/lib:$BASE/lib/arm-linux-gnueabi:$BASE/lib/arm-linux-gnueabi/lxpanel"
FBSTATE="$BASE/bin/h3531-fbstate"
XSETROOT="$BASE/bin/xsetroot"
LOCK=/var/h3531-native-app.lock
STATE=/var/h3531-native-fbstate.bin
LOG=/var/h3531-native-app.log
DISPLAY_VALUE=127.0.0.1:0

APPID="$1"
PROGRAM="$2"
FILE="$3"

[ -n "$APPID" ] || { echo "Usage: h3531-native-run <id> <program> [file]"; exit 2; }
[ -x "$PROGRAM" ] || { echo "ERROR: native executable missing: $PROGRAM"; exit 3; }
[ -x "$FBSTATE" ] || { echo "ERROR: framebuffer state helper missing: $FBSTATE"; exit 4; }

if [ -e "$LOCK" ]; then
    echo "ERROR: another native application lease is active"
    exit 5
fi
: >"$LOCK" || exit 6
: >"$LOG"
echo "Stage6.6C Native App Bridge" >>"$LOG"
echo "app=$APPID program=$PROGRAM file=$FILE" >>"$LOG"

XPID=
for p in /proc/[0-9]*; do
    [ -r "$p/cmdline" ] || continue
    cmd="$(cat "$p/cmdline" 2>/dev/null)"
    case "$cmd" in
        *Xfbdev-shadow-full*)
            XPID="${p##*/}"
            break
            ;;
    esac
done

if [ -z "$XPID" ]; then
    echo "ERROR: persistent Xfbdev-shadow-full not found" >>"$LOG"
    rm -f "$LOCK"
    cat "$LOG"
    exit 20
fi

X_PAUSED=0
STATE_SAVED=0

resume_desktop()
{
    if [ "$STATE_SAVED" = "1" ]; then
        "$FBSTATE" restore /dev/fb0 "$STATE" >>"$LOG" 2>&1 ||
            echo "WARNING: framebuffer state restore failed" >>"$LOG"
        STATE_SAVED=0
    fi

    if [ "$X_PAUSED" = "1" ]; then
        kill -CONT "$XPID" 2>/dev/null || true
        X_PAUSED=0
        sleep 1

        # FullFrame Xfbdev copies the complete shadow root on any damage.
        # Re-setting the software cursor gives it a deterministic redraw kick.
        if [ -x "$XSETROOT" ]; then
            DISPLAY="$DISPLAY_VALUE" "$LOADER" --library-path "$LIBPATH" \
                "$XSETROOT" -display "$DISPLAY_VALUE" -cursor_name left_ptr \
                >>"$LOG" 2>&1 || true
        fi
    fi

    rm -f "$LOCK"
}

on_signal()
{
    echo "bridge interrupted; restoring desktop" >>"$LOG"
    resume_desktop
    exit 70
}
trap on_signal 1 2 15

echo "X pid=$XPID" >>"$LOG"
"$FBSTATE" save /dev/fb0 "$STATE" >>"$LOG" 2>&1 || {
    echo "ERROR: cannot save framebuffer state" >>"$LOG"
    rm -f "$LOCK"
    cat "$LOG"
    exit 21
}
STATE_SAVED=1

kill -STOP "$XPID" 2>/dev/null || {
    echo "ERROR: cannot pause X server" >>"$LOG"
    resume_desktop
    cat "$LOG"
    exit 22
}
X_PAUSED=1
sleep 1
echo "X paused; native lease active" >>"$LOG"

if [ -n "$FILE" ]; then
    "$PROGRAM" "$FILE" >>"$LOG" 2>&1
else
    "$PROGRAM" >>"$LOG" 2>&1
fi
RC=$?
echo "native application exited rc=$RC" >>"$LOG"

resume_desktop
echo "desktop resumed" >>"$LOG"
exit "$RC"
