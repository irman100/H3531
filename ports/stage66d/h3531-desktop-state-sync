#!/bin/sh
# H3531 Stage6.8.0AA desktop UI persistence v2.
# Keep live LXDE config in /var for old Wheezy/LXDE compatibility, but mirror
# user-editable text files to persistent storage without replacing whole
# directories on every poll. This avoids the old FAT rename window that could
# lose a profile on hard reset.

HOME_DIR=${H3531_HOME_DIR:-/var/h3531-lxde}
RUNTIME_CONFIG="$HOME_DIR/.config"
USB_PERSIST=/mnt/usb/H3531/USER/desktop-state-v2
LEGACY_USB_PERSIST=/mnt/usb/H3531/USER/desktop-state-v1
MTD_PERSIST=/mnt/mtd/h3531-user/desktop-state-v2
PERSIST=
PERSIST_KIND=

probe_store()
{
    ROOT="$1"
    PROBE="$ROOT/.h3531-probe-$/a/b"
    FILE="$PROBE/write-test"

    mkdir -p "$PROBE" 2>/dev/null || {
        rm -rf "$ROOT/.h3531-probe-$" 2>/dev/null
        return 1
    }

    : >"$FILE" 2>/dev/null || {
        rm -rf "$ROOT/.h3531-probe-$" 2>/dev/null
        return 1
    }

    [ -f "$FILE" ] || {
        rm -rf "$ROOT/.h3531-probe-$" 2>/dev/null
        return 1
    }

    rm -rf "$ROOT/.h3531-probe-$" 2>/dev/null
    return 0
}

select_persist()
{
    if probe_store "$USB_PERSIST"; then
        PERSIST="$USB_PERSIST"
        PERSIST_KIND=usb
        return 0
    fi

    if probe_store "$MTD_PERSIST"; then
        PERSIST="$MTD_PERSIST"
        PERSIST_KIND=mtd
        return 0
    fi

    PERSIST=
    PERSIST_KIND=
    return 1
}

fallback_to_mtd()
{
    [ "$PERSIST_KIND" = "usb" ] || return 1

    if probe_store "$MTD_PERSIST"; then
        echo "WARNING: USB desktop-state store failed; switching to MTD fallback"
        PERSIST="$MTD_PERSIST"
        PERSIST_KIND=mtd
        return 0
    fi

    echo "ERROR: USB desktop-state store failed and MTD fallback is unavailable"
    return 1
}

# Stage6.8.0X replaced whole directories using DST -> .old -> TMP -> DST.
# If power was removed between those renames, the normal DST can be absent.
# Recover the first surviving old copy before v2 starts file-level mirroring.
recover_legacy_dir()
{
    REL="$1"
    TOP=${REL%%/*}
    LEAF=${REL##*/}
    DST="$PERSIST/config/$REL"
    PARENT="$PERSIST/config/$TOP"

    [ -d "$DST" ] && return 0
    [ -d "$PARENT" ] || return 0

    for OLD in "$PARENT"/.h3531-"$LEAF".old.*; do
        [ -d "$OLD" ] || continue
        if mv "$OLD" "$DST" 2>/dev/null; then
            echo "recovered legacy $REL from ${OLD##*/}"
            return 0
        fi
    done
    return 0
}

same_text_file()
{
    A="$1"
    B="$2"
    [ -f "$A" ] || return 1
    [ -f "$B" ] || return 1

    # All persisted desktop-state files are text. Command substitution is used
    # deliberately so this works on the target's very small BusyBox without
    # relying on cmp/cksum/find applets.
    ATEXT=`cat "$A" 2>/dev/null`
    BTEXT=`cat "$B" 2>/dev/null`
    [ "$ATEXT" = "$BTEXT" ]
}

restore_file()
{
    REL="$1"
    SRC="$PERSIST/config/$REL"
    DST="$RUNTIME_CONFIG/$REL"
    if [ ! -f "$SRC" ] && [ -f "$LEGACY_USB_PERSIST/config/$REL" ]; then
        SRC="$LEGACY_USB_PERSIST/config/$REL"
        echo "import legacy $REL"
    fi
    [ -f "$SRC" ] || return 0

    PARENT=${DST%/*}
    mkdir -p "$PARENT" 2>/dev/null || return 1

    TMP="$DST.restore.$$"
    rm -f "$TMP" 2>/dev/null
    cp "$SRC" "$TMP" 2>/dev/null || {
        rm -f "$TMP" 2>/dev/null
        return 1
    }
    mv "$TMP" "$DST" 2>/dev/null || {
        rm -f "$TMP" 2>/dev/null
        return 1
    }
    echo "restore $REL"
    return 0
}

sync_file()
{
    REL="$1"
    SRC="$RUNTIME_CONFIG/$REL"
    DST="$PERSIST/config/$REL"
    [ -f "$SRC" ] || return 0

    same_text_file "$SRC" "$DST" && return 0

    PARENT=${DST%/*}
    mkdir -p "$PARENT" 2>/dev/null || return 1

    TMP="$DST.new.$$"
    rm -f "$TMP" 2>/dev/null
    cp "$SRC" "$TMP" 2>/dev/null || {
        rm -f "$TMP" 2>/dev/null
        return 1
    }

    # File-level replacement leaves the previous destination in place until the
    # new copy has been fully written. This is safer on VFAT than replacing the
    # complete profile directory every two seconds.
    if mv "$TMP" "$DST" 2>/dev/null; then
        :
    elif cp "$TMP" "$DST" 2>/dev/null; then
        rm -f "$TMP" 2>/dev/null
        echo "WARNING: mv fallback used for $REL"
    else
        echo "ERROR: cannot write persistent file $REL"
        rm -f "$TMP" 2>/dev/null
        return 1
    fi

    if [ ! -f "$DST" ]; then
        echo "ERROR: persistent file missing after write: $REL"
        return 1
    fi

    echo "persist $REL"
    return 0
}

restore_flat_dir()
{
    REL="$1"
    SRC="$PERSIST/config/$REL"
    if [ ! -d "$SRC" ] && [ -d "$LEGACY_USB_PERSIST/config/$REL" ]; then
        SRC="$LEGACY_USB_PERSIST/config/$REL"
        echo "import legacy directory $REL"
    fi
    [ -d "$SRC" ] || return 0
    for F in "$SRC"/*; do
        [ -f "$F" ] || continue
        restore_file "$REL/${F##*/}"
    done
}

sync_flat_dir()
{
    REL="$1"
    SRC="$RUNTIME_CONFIG/$REL"
    [ -d "$SRC" ] || return 0
    for F in "$SRC"/*; do
        [ -f "$F" ] || continue
        sync_file "$REL/${F##*/}"
    done
}

restore_lxpanel()
{
    restore_file lxpanel/LXDE/config
    restore_file lxpanel/LXDE/gtkrc
    restore_flat_dir lxpanel/LXDE/panels
}

sync_panel_critical()
{
    PANEL_REL=lxpanel/LXDE/panels/panel
    PANEL_SRC="$RUNTIME_CONFIG/$PANEL_REL"
    PANEL_DST="$PERSIST/config/$PANEL_REL"
    PANEL_PARENT="${PANEL_DST%/*}"
    PANEL_ERR=/var/h3531-panel-persist.err

    [ -f "$PANEL_SRC" ] || {
        echo "WARNING: LXPanel runtime panel does not exist: $PANEL_SRC"
        return 0
    }

    same_text_file "$PANEL_SRC" "$PANEL_DST" && return 0

    : >"$PANEL_ERR"
    mkdir -p "$PANEL_PARENT" 2>>"$PANEL_ERR" || {
        echo "ERROR: cannot create LXPanel persistent directory: $PANEL_PARENT"
        cat "$PANEL_ERR" 2>/dev/null

        if fallback_to_mtd; then
            PANEL_DST="$PERSIST/config/$PANEL_REL"
            PANEL_PARENT="${PANEL_DST%/*}"
            : >"$PANEL_ERR"
            mkdir -p "$PANEL_PARENT" 2>>"$PANEL_ERR" || {
                echo "ERROR: cannot create MTD LXPanel persistent directory: $PANEL_PARENT"
                cat "$PANEL_ERR" 2>/dev/null
                return 1
            }
        else
            return 1
        fi
    }

    # H3531 target uses an old BusyBox and a VFAT USB store. For the tiny panel
    # text profile the most compatible write path is shell redirection + cat:
    # no cp metadata handling, no cross-directory rename, no temp-name window.
    { cat "$PANEL_SRC"; } 2>>"$PANEL_ERR" >"$PANEL_DST"
    RC=$?
    if [ "$RC" -ne 0 ] || [ ! -f "$PANEL_DST" ]; then
        echo "ERROR: direct LXPanel persistent write failed rc=$RC"
        cat "$PANEL_ERR" 2>/dev/null
        echo "panel src=$PANEL_SRC"
        echo "panel dst=$PANEL_DST"
        return 1
    fi

    /bin/busybox sync >/dev/null 2>&1 || true
    echo "persist $PANEL_REL (direct-vfat)"
    return 0
}

sync_lxpanel()
{
    # The main panel file has a dedicated old-BusyBox/VFAT-safe path.
    sync_panel_critical
    sync_file lxpanel/LXDE/config
    sync_file lxpanel/LXDE/gtkrc
    sync_flat_dir lxpanel/LXDE/panels

    PANEL_SRC="$RUNTIME_CONFIG/lxpanel/LXDE/panels/panel"
    PANEL_DST="$PERSIST/config/lxpanel/LXDE/panels/panel"
    if [ -f "$PANEL_SRC" ] && [ ! -f "$PANEL_DST" ]; then
        echo "ERROR: LXPanel runtime profile exists but persistent panel is missing after direct write"
        return 1
    fi
}

restore_home_file()
{
    REL="$1"
    SRC="$PERSIST/home/$REL"
    DST="$HOME_DIR/$REL"
    if [ ! -f "$SRC" ] && [ -f "$LEGACY_USB_PERSIST/home/$REL" ]; then
        SRC="$LEGACY_USB_PERSIST/home/$REL"
        echo "import legacy home/$REL"
    fi
    [ -f "$SRC" ] || return 0

    PARENT=${DST%/*}
    mkdir -p "$PARENT" 2>/dev/null || return 1
    TMP="$DST.restore.$$"
    cp "$SRC" "$TMP" 2>/dev/null || {
        rm -f "$TMP" 2>/dev/null
        return 1
    }
    mv "$TMP" "$DST" 2>/dev/null || {
        rm -f "$TMP" 2>/dev/null
        return 1
    }
    echo "restore home/$REL"
}

sync_home_file()
{
    REL="$1"
    SRC="$HOME_DIR/$REL"
    DST="$PERSIST/home/$REL"
    [ -f "$SRC" ] || return 0

    same_text_file "$SRC" "$DST" && return 0

    PARENT=${DST%/*}
    mkdir -p "$PARENT" 2>/dev/null || return 1
    TMP="$DST.new.$$"
    cp "$SRC" "$TMP" 2>/dev/null || {
        rm -f "$TMP" 2>/dev/null
        return 1
    }
    mv "$TMP" "$DST" 2>/dev/null || {
        rm -f "$TMP" 2>/dev/null
        return 1
    }
    echo "persist home/$REL"
}

restore_all()
{
    restore_lxpanel
    restore_flat_dir pcmanfm/LXDE
    restore_flat_dir lxsession/LXDE
    restore_flat_dir openbox
    restore_flat_dir lxterminal
    restore_flat_dir libfm
    restore_flat_dir lxappearance
    restore_file user-dirs.dirs
    restore_file user-dirs.locale
    restore_home_file .gtkrc-2.0
}

sync_all()
{
    sync_lxpanel
    sync_flat_dir pcmanfm/LXDE
    sync_flat_dir lxsession/LXDE
    sync_flat_dir openbox
    sync_flat_dir lxterminal
    sync_flat_dir libfm
    sync_flat_dir lxappearance
    sync_file user-dirs.dirs
    sync_file user-dirs.locale
    sync_home_file .gtkrc-2.0
}

select_persist || true

case "$1" in
    restore)
        if [ -n "$PERSIST" ]; then
            echo "persistent desktop store: $PERSIST"
            echo "desktop-state format: v3 clean-store + legacy import"
            restore_all
        else
            echo "WARNING: no writable persistent desktop store; runtime settings only"
        fi
        ;;
    sync)
        [ -n "$PERSIST" ] && sync_all
        ;;
    daemon)
        if [ -z "$PERSIST" ]; then
            echo "WARNING: no writable persistent desktop store; persistence daemon disabled"
            exit 0
        fi
        echo "persistent desktop store: $PERSIST"
        echo "desktop-state format: v3 clean-store + legacy import"
        while true; do
            sync_all
            sleep 2
        done
        ;;
    *)
        echo "usage: $0 restore|sync|daemon" >&2
        exit 64
        ;;
esac
