#!/bin/sh
# H3531 Stage6.8.0X desktop settings persistence.
# Keep the live LXDE profile on /var for compatibility, while mirroring only
# stable user-editable settings to persistent storage.

HOME_DIR=${H3531_HOME_DIR:-/var/h3531-lxde}
RUNTIME_CONFIG="$HOME_DIR/.config"
USB_PERSIST=/mnt/usb/H3531/USER/desktop-state-v1
MTD_PERSIST=/mnt/mtd/h3531-user/desktop-state-v1
PERSIST=

select_persist()
{
    if mkdir -p "$USB_PERSIST" 2>/dev/null; then
        TEST="$USB_PERSIST/.write-test.$$"
        if : >"$TEST" 2>/dev/null; then
            rm -f "$TEST" 2>/dev/null
            PERSIST="$USB_PERSIST"
            return 0
        fi
    fi

    if mkdir -p "$MTD_PERSIST" 2>/dev/null; then
        TEST="$MTD_PERSIST/.write-test.$$"
        if : >"$TEST" 2>/dev/null; then
            rm -f "$TEST" 2>/dev/null
            PERSIST="$MTD_PERSIST"
            return 0
        fi
    fi

    PERSIST=
    return 1
}

restore_dir()
{
    REL="$1"
    SRC="$PERSIST/config/$REL"
    DST="$RUNTIME_CONFIG/$REL"
    [ -d "$SRC" ] || return 0
    mkdir -p "$DST" 2>/dev/null || return 1
    cp -R "$SRC"/. "$DST"/ 2>/dev/null || return 1
    echo "restore $REL"
}

sync_dir()
{
    REL="$1"
    SRC="$RUNTIME_CONFIG/$REL"
    [ -d "$SRC" ] || return 0

    TOP=${REL%%/*}
    LEAF=${REL##*/}
    PARENT="$PERSIST/config/$TOP"
    DST="$PERSIST/config/$REL"
    TMP="$PARENT/.h3531-$LEAF.tmp.$$"
    OLD="$PARENT/.h3531-$LEAF.old.$$"

    mkdir -p "$PARENT" 2>/dev/null || return 1
    rm -rf "$TMP" "$OLD" 2>/dev/null
    mkdir -p "$TMP" 2>/dev/null || return 1
    cp -R "$SRC"/. "$TMP"/ 2>/dev/null || {
        rm -rf "$TMP" 2>/dev/null
        return 1
    }

    if [ -e "$DST" ]; then
        mv "$DST" "$OLD" 2>/dev/null || {
            rm -rf "$TMP" 2>/dev/null
            return 1
        }
    fi

    if mv "$TMP" "$DST" 2>/dev/null; then
        rm -rf "$OLD" 2>/dev/null
        echo "persist $REL"
        return 0
    fi

    rm -rf "$TMP" 2>/dev/null
    if [ -e "$OLD" ]; then
        mv "$OLD" "$DST" 2>/dev/null || true
    fi
    return 1
}

restore_all()
{
    restore_dir lxpanel/LXDE
    restore_dir pcmanfm/LXDE
    restore_dir lxsession/LXDE
}

sync_all()
{
    sync_dir lxpanel/LXDE
    sync_dir pcmanfm/LXDE
    sync_dir lxsession/LXDE
}

select_persist || true

case "$1" in
    restore)
        if [ -n "$PERSIST" ]; then
            echo "persistent desktop store: $PERSIST"
            restore_all
        else
            echo "WARNING: no writable persistent desktop store; runtime settings only"
        fi
        ;;
    sync)
        [ -n "$PERSIST" ] && sync_all
        ;;
    daemon)
        if [ -z "$PERSIST" ]; then
            echo "WARNING: no writable persistent desktop store; persistence daemon disabled"
            exit 0
        fi
        echo "persistent desktop store: $PERSIST"
        while true; do
            sync_all
            sleep 2
        done
        ;;
    *)
        echo "usage: $0 restore|sync|daemon" >&2
        exit 64
        ;;
esac
