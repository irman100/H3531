#!/bin/sh
# H3531 Stage6.6D Live Native Lease.
# Keep X/LXDE alive. Suppress only shadow->physical framebuffer output while
# the native app owns /dev/fb0, and disable X evdev devices via XInput.

BASE=/mnt/usb/H3531/APPS/x11-debian
LOADER="$BASE/lib/ld-linux.so.3"
LIBPATH="$BASE/lib:$BASE/lib/arm-linux-gnueabi:$BASE/lib/arm-linux-gnueabi/lxpanel"
FBSTATE="$BASE/bin/h3531-fbstate"
XINPUT="$BASE/bin/xinput"
XREFRESH="$BASE/bin/xrefresh"
XSETROOT="$BASE/bin/xsetroot"
LOCKSYNC="$BASE/bin/h3531-locksync"
LOCKSTATE=/var/h3531-native-lockstate.env
LOCK=/var/h3531-native-app.lock
LEASE=/var/h3531-xfbdev-native-lease
STATE=/var/h3531-native-fbstate.bin
LOG=/var/h3531-native-app.log
X_PIDFILE=/var/h3531-xfbdev.pid
X_MODEFILE=/var/h3531-xfbdev.mode
INPUT_ENV=/var/h3531-input.env
INPUT_DISCOVER="$BASE/bin/h3531-input-discover"
DISPLAY_VALUE=127.0.0.1:0

APPID="$1"
PROGRAM="$2"
FILE="$3"

[ -n "$APPID" ] || { echo "Usage: h3531-native-run <id> <program> [file]"; exit 2; }
[ -x "$PROGRAM" ] || { echo "ERROR: native executable missing: $PROGRAM"; exit 3; }
[ -x "$FBSTATE" ] || { echo "ERROR: framebuffer helper missing: $FBSTATE"; exit 4; }
[ -x "$XINPUT" ] || { echo "ERROR: xinput helper missing: $XINPUT"; exit 5; }

if [ -e "$LOCK" ]; then
    echo "ERROR: another native application lease is active"
    exit 6
fi
: >"$LOCK" || exit 7
: >"$LOG"
echo "Stage6.6D Live Native Lease" >>"$LOG"
echo "app=$APPID program=$PROGRAM file=$FILE" >>"$LOG"

XPID=
if [ -r "$X_PIDFILE" ]; then
    XPID="$(cat "$X_PIDFILE" 2>/dev/null)"
    if [ -n "$XPID" ] && ! kill -0 "$XPID" 2>/dev/null; then
        XPID=
    fi
fi

if [ -z "$XPID" ]; then
    for p in /proc/[0-9]*; do
        [ -r "$p/cmdline" ] || continue
        cmd="$(cat "$p/cmdline" 2>/dev/null)"
        case "$cmd" in
            *Xfbdev-shadow-live*)
                XPID="${p##*/}"
                break
                ;;
        esac
    done
fi

XMODE=
[ -r "$X_MODEFILE" ] && XMODE="$(cat "$X_MODEFILE" 2>/dev/null)"

if [ -z "$XPID" ]; then
    echo "ERROR: live-lease Xfbdev not found" >>"$LOG"
    rm -f "$LOCK"
    cat "$LOG"
    exit 20
fi

if [ -n "$XMODE" ] && [ "$XMODE" != "shadow-live" ]; then
    echo "ERROR: active X mode is '$XMODE', expected shadow-live" >>"$LOG"
    rm -f "$LOCK"
    cat "$LOG"
    exit 20
fi

STATE_SAVED=0
LEASE_ACTIVE=0
KBD_DISABLED=0
MOUSE_DISABLED=0
INPUT_RECOVERY_NEEDED=0

xinput_prop()
{
    DISPLAY="$DISPLAY_VALUE" "$LOADER" --library-path "$LIBPATH" "$XINPUT" \
        set-prop "$1" "Device Enabled" "$2" >>"$LOG" 2>&1
}

resume_desktop()
{
    # Native process has already closed its evdev fds at this point.
    # Capture the physical Caps/Num LED state before X takes the keyboard
    # back. Native applications may have changed the real lock state while
    # XInput was disabled.
    LOCKSTATE_SAVED=0
    if [ -x "$LOCKSYNC" ]; then
        if "$LOADER" --library-path "$LIBPATH" "$LOCKSYNC" snapshot "$LOCKSTATE" >>"$LOG" 2>&1; then
            LOCKSTATE_SAVED=1
        else
            echo "WARNING: cannot snapshot physical keyboard lock state" >>"$LOG"
        fi
    fi
    if [ "$STATE_SAVED" = "1" ]; then
        "$FBSTATE" restore /dev/fb0 "$STATE" >>"$LOG" 2>&1 ||
            echo "WARNING: framebuffer restore failed" >>"$LOG"
        STATE_SAVED=0
    fi

    if [ "$KBD_DISABLED" = "1" ]; then
        if ! xinput_prop "Evdev keyboard" 1; then
            echo "WARNING: X keyboard re-enable failed; desktop recovery required" >>"$LOG"
            INPUT_RECOVERY_NEEDED=1
        fi
        KBD_DISABLED=0
    fi
    if [ "$MOUSE_DISABLED" = "1" ]; then
        if ! xinput_prop "Evdev mouse" 1; then
            echo "WARNING: X mouse re-enable failed; desktop recovery required" >>"$LOG"
            INPUT_RECOVERY_NEEDED=1
        fi
        MOUSE_DISABLED=0
    fi

    if [ "$LOCKSTATE_SAVED" = "1" ] && [ -x "$LOCKSYNC" ]; then
        if ! DISPLAY="$DISPLAY_VALUE" "$LOADER" --library-path "$LIBPATH"             "$LOCKSYNC" apply "$DISPLAY_VALUE" "$LOCKSTATE" >>"$LOG" 2>&1; then
            echo "WARNING: cannot import native Caps/Num state into XKB" >>"$LOG"
        fi
    fi
    rm -f "$LOCKSTATE" 2>/dev/null

    if [ "$LEASE_ACTIVE" = "1" ]; then
        rm -f "$LEASE"
        LEASE_ACTIVE=0
        echo "physical framebuffer lease released" >>"$LOG"

        # Generate deterministic X damage. FullFrame then copies the complete
        # current shadow desktop back into /dev/fb0.
        if [ -x "$XREFRESH" ]; then
            DISPLAY="$DISPLAY_VALUE" "$LOADER" --library-path "$LIBPATH" \
                "$XREFRESH" -display "$DISPLAY_VALUE" >>"$LOG" 2>&1 || true
        elif [ -x "$XSETROOT" ]; then
            DISPLAY="$DISPLAY_VALUE" "$LOADER" --library-path "$LIBPATH" \
                "$XSETROOT" -display "$DISPLAY_VALUE" -cursor_name left_ptr \
                >>"$LOG" 2>&1 || true
        fi
        sleep 1
    fi

    rm -f "$LOCK"

    if [ "$INPUT_RECOVERY_NEEDED" = "1" ]; then
        echo "requesting self-healing desktop restart after XInput loss" >>"$LOG"
        if [ -n "$XPID" ] && kill -0 "$XPID" 2>/dev/null; then
            kill "$XPID" 2>/dev/null || true
        fi
    fi
}

on_signal()
{
    echo "bridge interrupted; restoring desktop" >>"$LOG"
    resume_desktop
    exit 70
}
trap on_signal 1 2 15

echo "X live pid=$XPID" >>"$LOG"
"$FBSTATE" save /dev/fb0 "$STATE" >>"$LOG" 2>&1 || {
    echo "ERROR: cannot save framebuffer state" >>"$LOG"
    rm -f "$LOCK"
    cat "$LOG"
    exit 21
}
STATE_SAVED=1

# Suppress X shadow flushes before turning its evdev devices off.
: >"$LEASE" || {
    echo "ERROR: cannot create framebuffer lease marker" >>"$LOG"
    resume_desktop
    cat "$LOG"
    exit 22
}
LEASE_ACTIVE=1
sleep 1

if ! xinput_prop "Evdev keyboard" 0; then
    echo "ERROR: cannot release X keyboard device" >>"$LOG"
    resume_desktop
    cat "$LOG"
    exit 23
fi
KBD_DISABLED=1

if ! xinput_prop "Evdev mouse" 0; then
    echo "ERROR: cannot release X mouse device" >>"$LOG"
    resume_desktop
    cat "$LOG"
    exit 24
fi
MOUSE_DISABLED=1
sleep 1
echo "X remains live; framebuffer and evdev leased to native app" >>"$LOG"

# Stage6.8.0B: refresh discovery at native-app launch time. A keyboard can
# be absent during boot and appear later at a different eventN, so the old
# boot-time /var/h3531-input.env must never be treated as authoritative here.
if [ -x "$INPUT_DISCOVER" ]; then
    rm -f "$INPUT_ENV" 2>/dev/null
    H3531_INPUT_ALLOW_MISSING=1 H3531_INPUT_LOG=/var/h3531-native-input.log \
        "$INPUT_DISCOVER" "$INPUT_ENV" >>"$LOG" 2>&1 || true
fi

unset H3531_NATIVE_KEYBOARD NOFRENDO_INPUT GAMEFRONT_INPUT

if [ -r "$INPUT_ENV" ]; then
    H3531_X11_KEYBD=
    H3531_X11_MOUSE=
    . "$INPUT_ENV"

    if [ -n "$H3531_X11_KEYBD" ] && [ -c "$H3531_X11_KEYBD" ]; then
        H3531_NATIVE_KEYBOARD="$H3531_X11_KEYBD"
        export H3531_NATIVE_KEYBOARD
        echo "native keyboard=$H3531_NATIVE_KEYBOARD" >>"$LOG"

        case "$APPID" in
            nofrendo)
                NOFRENDO_INPUT="$H3531_NATIVE_KEYBOARD"
                export NOFRENDO_INPUT
                echo "Nofrendo forced input=$NOFRENDO_INPUT" >>"$LOG"
                ;;
            steamflash|stayplaytion|gamefront)
                GAMEFRONT_INPUT="$H3531_NATIVE_KEYBOARD"
                export GAMEFRONT_INPUT
                echo "Stayplaytion forced input=$GAMEFRONT_INPUT" >>"$LOG"
                ;;
        esac
    else
        echo "WARNING: dynamic native keyboard unavailable" >>"$LOG"
    fi
fi

if [ -n "$FILE" ]; then
    "$PROGRAM" "$FILE" >>"$LOG" 2>&1
else
    "$PROGRAM" >>"$LOG" 2>&1
fi
RC=$?
echo "native application exited rc=$RC" >>"$LOG"

resume_desktop
echo "desktop live lease restored" >>"$LOG"
exit "$RC"
