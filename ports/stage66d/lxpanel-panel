# H3531 LXPanel profile - D6 application-safe auto-hide
Global {
  edge=bottom
  allign=left
  margin=0
  widthtype=percent
  width=100
  height=36
  transparent=0
  tintcolor=#F2F2F2
  alpha=255
  autohide=1
  heightwhenhidden=2
  setdocktype=1
  setpartialstrut=1
  usefontcolor=1
  fontcolor=#101010
  usefontsize=1
  fontsize=11
  background=0
  iconsize=28
}
Plugin {
  type=menu
  Config {
    image=/var/share/lxpanel/images/my-computer.png
    system {
    }
    separator {
    }
    item {
      command=run
    }
  }
}
Plugin {
  type=launchbar
  Config {
    Button { id=h3531-file-manager.desktop }
    Button { id=h3531-terminal.desktop }
  }
}
Plugin {
  type=taskbar
  expand=1
  Config {
    tooltips=1
    IconsOnly=0
    ShowAllDesks=0
    UseMouseWheel=1
    UseUrgencyHint=1
    FlatButton=0
    MaxTaskWidth=200
    spacing=1
  }
}
Plugin { type=tray Config { } }
Plugin { type=netstatus Config { iface=eth0 } }
Plugin {
  type=dclock
  Config {
    ClockFmt=%H:%M
    TooltipFmt=%A %x
    BoldFont=0
  }
}
